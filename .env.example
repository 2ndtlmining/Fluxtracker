# ============================================
# Database Mode (sqlite or supabase, default: supabase)
# ============================================
# DB_TYPE=sqlite
# DB_PATH=data/fluxtracker.sqlite3

# ============================================
# Supabase (required when DB_TYPE=supabase or unset)
# ============================================
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: Direct PostgreSQL connection for DDL migrations
# SUPABASE_DB_URL=

# Optional: Failover Supabase instance (auto-switch when primary is unreachable)
# SUPABASE_FAILOVER_URL=
# SUPABASE_FAILOVER_KEY=
# Where the live instance (primary/failover) is remembered across restarts.
# FAILOVER_STATE_FILE=data/supabase-active.json

# ============================================
# Ports, host and logging
# PORT is what the Express API actually binds to.
# API_PORT is where start:all, Docker and the SvelteKit /api/* proxy look for it --
# `npm run api` on its own ignores API_PORT, so set PORT for that.
# ORIGIN is adapter-node's CSRF origin: anyone serving this on a real domain must set it.
# ============================================
# PORT=3000
# API_PORT=3000
# FRONTEND_PORT=5173
# HOST=0.0.0.0
# ORIGIN=https://your-domain.example
# LOG_LEVEL=info
# LOG_FORMAT=pretty

# ============================================
# Historical prices
# Third and last source, tried only if set. Binance and CoinGecko need no key and cover
# almost everything; CryptoCompare returns HTTP 401 without one.
# ============================================
# CRYPTOCOMPARE_API_KEY=

# ============================================
# Cloudflare R2 Backup (primary instance only)
# All 4 required to enable automatic backups to R2
# ============================================
# R2_ENDPOINT=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=

# ============================================
# Bootstrap from R2 (Docker/SQLite instances only)
# Downloads latest backup on first start when DB is empty
# Use separate read-only R2 credentials for safety
# ============================================
# BOOTSTRAP_R2_ENDPOINT=
# BOOTSTRAP_R2_ACCESS_KEY_ID=
# BOOTSTRAP_R2_SECRET_ACCESS_KEY=
# BOOTSTRAP_R2_BUCKET_NAME=

# ============================================
# CORS allowed origins (production only — local dev origins are always allowed)
# Comma-separated list of scheme://host[:port] entries the API accepts cross-origin
# requests from. Leave unset in development.
# ============================================
# CORS_ALLOWED_ORIGINS=https://your-domain.example,http://203.0.113.10:37000

# ============================================
# Scheduled KPI Reports (all unset = feature off)
# KPI_WEBHOOK_URL: Discord webhook the reports are posted to
# KPI_SCHEDULE: any comma-separated mix of daily, weekly, monthly, quarterly, yearly
# KPI_SCHEDULE_HOUR_UTC: hour of day (UTC) the daily run fires (default 2)
# The manual KPI button keeps working independently of this
# ============================================
# KPI_WEBHOOK_URL=
# KPI_SCHEDULE=daily
# KPI_SCHEDULE_HOUR_UTC=2
